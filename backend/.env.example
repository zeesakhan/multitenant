# Application
APP_NAME=Health Insurance Platform
APP_VERSION=1.0.0
DEBUG=false

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/health_insurance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Celery / RabbitMQ
CELERY_BROKER_URL=amqp://user:password@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO

# Encryption (for storing integration credentials)
ENCRYPTION_KEY=change-this-to-a-secure-random-string-in-production

# Feature flags (per-platform defaults, overridden per tenant)
ENABLE_CLAIMS=false
ENABLE_GOVERNMENT_INTEGRATION=false
ENABLE_BATCH_PROCESSING=false
