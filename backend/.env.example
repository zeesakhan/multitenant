# ============================================================
# Health Insurance Platform — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# ============================================================

# Application
APP_NAME=Health Insurance Platform
APP_VERSION=1.0.0
DEBUG=false

# Database (PostgreSQL for production; use sqlite:///./dev.db for local dev)
DATABASE_URL=postgresql://user:password@localhost:5432/health_insurance
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# JWT — CHANGE BOTH SECRETS before deploying to production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MINIMUM-32-CHARS
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# CORS (JSON array of allowed origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Celery / RabbitMQ (only needed if background tasks are enabled)
CELERY_BROKER_URL=amqp://user:password@localhost:5672/
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Logging
LOG_LEVEL=INFO

# Encryption — CHANGE THIS before deploying to production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=CHANGE-THIS-TO-A-SECURE-RANDOM-STRING-MINIMUM-32-CHARS

# Email / SMTP
# Leave SMTP_HOST empty to use dev-mode logging (no emails actually sent).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@yourdomain.com

# Frontend URL — used in password-reset emails
FRONTEND_URL=https://app.yourdomain.com

# Rate limiting — max login attempts per minute per IP
LOGIN_RATE_LIMIT=10

# Feature flags
ENABLE_CLAIMS=true
ENABLE_GOVERNMENT_INTEGRATION=false
ENABLE_BATCH_PROCESSING=false
