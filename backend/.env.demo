APP_NAME=Health Insurance Platform
APP_VERSION=1.0.0
DEBUG=true

# IMPORTANT: Change 'YOUR_MAC_USERNAME' to your macOS username on the new machine
# Run: whoami  — to find your username
DATABASE_URL=postgresql://YOUR_MAC_USERNAME@localhost:5432/health_insurance
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_ECHO=false

REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

SECRET_KEY=6b82a32e07bda4366e6938dd18956e02d81ad5e7018c7ac7f63c83c9cc211d94
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://0.0.0.0:5173"]

CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3

LOG_LEVEL=INFO

ENCRYPTION_KEY=83fc0097f2f7dcafbe87136dd43b06b9894373697f545a65a470162f33ee0dfd

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@localhost

FRONTEND_URL=http://localhost:5173

LOGIN_RATE_LIMIT=10

ENABLE_CLAIMS=true
ENABLE_GOVERNMENT_INTEGRATION=false
ENABLE_BATCH_PROCESSING=false

# PDF generation (WeasyPrint requires Homebrew GTK/Pango on macOS)
DYLD_LIBRARY_PATH=/opt/homebrew/lib

# Payment gateway (Network International UAE) — mock mode for demo
PAYMENT_GATEWAY_MOCK=true
PAYMENT_GATEWAY_API_KEY=
PAYMENT_GATEWAY_MERCHANT_ID=

# Government verification APIs — mock mode for demo
GOVT_API_MOCK=true
ICP_API_URL=
ICP_API_KEY=
DHA_API_URL=
DHA_API_KEY=

# AML / PEP screening — mock mode for demo
AML_MOCK=true
PEP_API_KEY=
PEP_API_URL=
